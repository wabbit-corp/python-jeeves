{
  "include": ["servant", "typed_json", "codi", "tests", "servant_app.py"],
  "exclude": [
    ".venv",
    ".git",
    "__pycache__",
    ".mypy_cache",
    ".pytest_cache",
    "data",
    "datasets"
  ],
  "stubPath": "stubs",
  "typeCheckingMode": "basic",
  "pythonVersion": "3.10",
  "venvPath": ".",
  "venv": ".venv",
  "reportMissingTypeStubs": "none",
  "reportMissingImports": "none",
  "reportUndefinedVariable": "error",
  "reportUnboundVariable": "error",
  "reportImportCycles": "error"
}
