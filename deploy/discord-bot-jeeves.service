[Unit]
Description=Jeeves Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=python-jeeves
Group=python-jeeves
WorkingDirectory=/opt/python-jeeves/current
Environment=JEEVES_CONFIG_PATH=/etc/python-jeeves/private.yml
Environment=JEEVES_DB_KEY_FILE=/etc/python-jeeves/database.key
Environment=HF_HOME=/var/cache/python-jeeves/huggingface
Environment=FASTEMBED_CACHE_PATH=/var/cache/python-jeeves/fastembed
Environment=XDG_CACHE_HOME=/var/cache/python-jeeves
ExecStart=/opt/python-jeeves/current/.venv/bin/python /opt/python-jeeves/current/servant_app.py
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=no
LogNamespace=vox
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,size=128M
TemporaryFileSystem=/var/tmp:rw,nosuid,nodev,noexec,size=32M
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/lib/python-jeeves /var/cache/python-jeeves
UMask=027
LimitMEMLOCK=256M

[Install]
WantedBy=multi-user.target
